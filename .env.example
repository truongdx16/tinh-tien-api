DB_DSN=tinh_tien:tinh_tien@tcp(localhost:2171)/tinh_tien?charset=utf8mb4&parseTime=True&loc=UTC
JWT_SECRET=change-me-in-production
HTTP_ADDR=:2170
APP_TIMEZONE=Asia/Ho_Chi_Minh
PUBLIC_BASE_URL=https://api.example.com
UPLOAD_DIR=uploads
# Tài khoản chủ hộ tạo bởi `make seed` (bắt buộc đổi trên production)
OWNER_USERNAME=owner
OWNER_PASSWORD=

# Push notifications (Firebase Cloud Messaging). Local: path of the
# service-account key, e.g. secrets/firebase-service-account.json (gitignored).
FCM_CREDENTIALS_FILE=
# Production: the same key, base64 on one line (base64 -i key.json | tr -d '\n').
FCM_CREDENTIALS_BASE64=
REMINDER_HOUR=7
