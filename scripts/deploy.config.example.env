# ============================================================
# Deploy configuration (copy to scripts/deploy.config.env — gitignored)
#   cp scripts/deploy.config.example.env scripts/deploy.config.env
# Any value can be overridden on the command line:
#   DRY_RUN=true ./scripts/deploy.sh
# ============================================================

# --- VPS connection (SSH key login) ---
VPS_HOST="your-vps-ip"
VPS_USER="root"
VPS_PORT="22"

# --- Site ---
DOMAIN="7b.truongdx.dev"
# Email for Let's Encrypt expiry notices (used by `setup`)
CERTBOT_EMAIL=""

# --- Paths / names on the VPS (match deploy/systemd and deploy/nginx) ---
VPS_PATH="/var/www/tinh-tien-api"
SERVICE_NAME="tinh-tien-api"
APP_USER="tinhtien"
API_PORT="2170"

# --- Build ---
# CPU of the VPS: amd64 (most VPS) or arm64
TARGET_ARCH="amd64"
# Run `go test ./...` before building
RUN_TESTS="true"

# --- Releases ---
# How many old releases to keep for rollback
KEEP_RELEASES="5"
# Dump the database to /root/db-backups on the VPS before each deploy
BACKUP_DB="true"
# Upload .env.production as the VPS .env
UPLOAD_ENV="true"
# Preview the upload without changing anything
DRY_RUN="false"
