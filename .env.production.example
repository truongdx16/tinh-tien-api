# ============================================================
# Production env for 7b.truongdx.dev
# Copy to .env.production (gitignored) and fill in:
#   cp .env.production.example .env.production
# `./scripts/deploy.sh` uploads it to the VPS as /var/www/tinh-tien-api/.env
# (old one kept as .env.bak-<time>). Edit here, then deploy — not on the VPS.
# ============================================================

# Turns on the startup safety checks (JWT secret, https URL).
APP_ENV=production

# MariaDB already on the VPS. loc=UTC is required (dates are stored in UTC).
# `./scripts/deploy.sh db-init` creates this database and user if missing.
DB_DSN=tinhtien:CHANGE_DB_PASSWORD@tcp(127.0.0.1:3306)/tinh_tien?charset=utf8mb4&parseTime=True&loc=UTC

# At least 32 random characters: openssl rand -hex 32
# Changing it signs everyone out (deploy.sh asks before replacing it).
JWT_SECRET=
# Thời hạn đăng nhập (30 ngày). Đổi thì người dùng đăng nhập lại khi token hết hạn.
TOKEN_TTL=720h

# Only nginx talks to the API.
HTTP_ADDR=127.0.0.1:2170
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Public URL, used to build image links returned by uploads.
PUBLIC_BASE_URL=https://7b.truongdx.dev
# Kept across deploys (outside the release folders); nginx serves /uploads/.
UPLOAD_DIR=/var/www/tinh-tien-api/uploads

# Push notifications (harvest / task reminders) via Firebase Cloud Messaging.
# Firebase console › Project settings › Service accounts › Generate new
# private key, then: base64 -i service-account.json | tr -d '\n'
# Empty = reminders are still listed in the app, just not pushed.
FCM_CREDENTIALS_BASE64=
# Hour (shop timezone) from which the day's reminders are sent.
REMINDER_HOUR=7

# Owner account created by `./scripts/deploy.sh seed` (first deploy only).
OWNER_USERNAME=
OWNER_PASSWORD=
